# TechForm Buddy Environment Variables

# ==============================================================================
# Google Gemini API Key
# ==============================================================================
# Required for server-side form field mapping and assistance
GEMINI_API_KEY="your-gemini-api-key-here"

# Gemini Flash Model (Default: gemini-3.1-flash-lite)
# Supported options: gemini-3.1-flash-lite, gemini-flash-latest
GEMINI_MODEL="gemini-3.1-flash-lite"

# ==============================================================================
# NextAuth Authentication Configuration
# ==============================================================================
NEXTAUTH_SECRET="change-this-to-a-secure-random-secret-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Provider (for "Continue with Google" sign in & sign up)
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ==============================================================================
# SMTP Mailer Configuration (Email Sending & 6-Digit OTP Verification)
# ==============================================================================
# Configured strictly through environment variables.
# NEVER commit credentials or secrets to git.
#
# Instructions to set up Gmail App Password for Development:
# 1. Sign in to your Google Account (https://myaccount.google.com/).
# 2. In the left navigation, click "Security".
# 3. Under "How you sign in to Google", ensure "2-Step Verification" is turned ON.
# 4. Open App Passwords directly at: https://myaccount.google.com/apppasswords
#    (Or search for "App passwords" in the search bar at the top).
# 5. Enter an app name (e.g. "TechForm Buddy Dev") and click "Create".
# 6. Copy the generated 16-character password (e.g., "abcd efgh ijkl mnop")
#    and paste it below as SMTP_PASS (spaces can be removed or kept).
# 7. Set SMTP_USER to your full Gmail address (e.g., "yourname@gmail.com").
# 8. Set SMTP_HOST to "smtp.gmail.com" and SMTP_PORT to "587".
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
MAIL_FROM_NAME="TechForm Buddy"
MAIL_FROM_ADDRESS="noreply@techformbuddy.com"

# ==============================================================================
# Dev Fallback for OTP (Only for Local Development)
# ==============================================================================
# When NODE_ENV=development and DEV_SHOW_OTP=true, the 6-digit OTP will be logged
# to the server terminal console if the email provider fails or is unconfigured.
# NOTE: This fallback is strictly impossible to enable when NODE_ENV=production.
DEV_SHOW_OTP="false"

# ==============================================================================
# Chrome Extension Integration
# ==============================================================================
# In production, set to your exact Chrome extension ID (e.g. chrome-extension://abcdefghijklmnop)
# In development, defaults to allowing chrome-extension:// origins
ALLOWED_EXTENSION_ORIGIN="*"

# ==============================================================================
# Web Push Notifications
# ==============================================================================
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# ==============================================================================
# Watcher Background Job Secret
# ==============================================================================
# Used by Cloud Scheduler or cron to trigger /api/watcher/run
WATCHER_SECRET="change-this-to-a-secure-random-secret"
